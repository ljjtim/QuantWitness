  "cards": [
    {
      "dot": "cyan",
      "title": "箭头与主链",
      "items": [
        "箭头统一表示调用或依赖；数据的流向见数据血缘图",
        "ResearchPackage → 一次 prepare + admit → 已准入计划 → run → Result → 报告 / 分析 / 开发反馈",
        "独立 package lint 用于主动诊断；Workspace execute 直接交接同次准备的已准入对象",
        "application 编排准入、执行与 Result 发布；RuntimeExecutionService 负责节点调度、资源与 checkpoint"
      ]
    },
    {
      "dot": "emerald",
      "title": "框架核心与依赖边界",
      "items": [
        "核心模块目录：cli、application、packages、catalog、data_plane、runtime、research、simulation、results、evidence、platform、domain、operations、extensions",
        "research 提供因子、模型和统计；Qlib 提供日频处理器与模型，训练、选择和 holdout 由主链约束",
        "simulation 与 domain 提供当前金融类型、账户与市场规则；股票和 ETF 日线 / 1m 策略经 integrations/lean 执行",
        "operations/framework_boundary.py 检查核心依赖边界；extensions/governance.py 管理项目扩展",
        "application/grid_data.py 组织数据节点；计划存储位于 application/research_plan_store.py",
        "Workspace 服务位于 workspace.py，流程在 application/workspace_flow.py；报告交付位于 application/result_delivery.py 与 application/report_output.py"
      ]
    },
    {
      "dot": "violet",
      "title": "只读输入与 Result 消费",
      "items": [
        "Catalog 从显式声明编译 Lock，准入检查物理绑定、漂移与 PIT；归档输入同样经过准入",
        "普通查询默认直接读取只读数据库或既有归档，只保存来源描述；--persist-inputs 才保存查询输入",
        "ResultAssembler / ResultStore 原子发布正式结果；报告、比较、分析、导出与 Dashboard 直接消费 Result",
        "evidence/result_analysis.py 生成 AnalysisResult，evidence/qlib_report.py 与 evidence/lean_report.py 提供报告投影",
        "全部节点成功但 Result 未发布时，resume 只重试组装；报告失败保留 Result，仅重新报告"
      ]
    },
    {
      "dot": "rose",
      "title": "适用范围",
      "items": [
        "图保留 14 个核心模块和既有外部组件位置，展示 RD-Agent、Qlib 与 LEAN 接入",
        "中国股票与 ETF 日线和一分钟策略由 LEAN 执行；金融类型中的期货口径不表示当前存在期货策略入口",
        "分钟行情、特征与标签 interval_minutes 固定为 1；PIT、历史规则、标签与持久 holdout 约束继续执行"
      ]
    },
    {
      "dot": "violet",
      "title": "RD-Agent 的位置与反馈边界",
      "items": [
        "RD-Agent 位于核心之外，经 Workspace 进入正式研究主链",
        "公式复现沿用已确认定义；探索只接收成功 Result 的开发指标，最终 test/holdout 不进入反馈",
        "Qlib 位于日频模型计算层，LEAN 位于策略执行层；节点成功与 Result 发布分别记录"
      ]
    }
  ]
}
