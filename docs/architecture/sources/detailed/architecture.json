  "cards": [
    {
      "dot": "cyan",
      "title": "箭头与主链",
      "items": [
        "箭头统一表示调用或依赖；数据的流向见数据血缘图",
        "ResearchPackage → lint → admit → 已准入计划 → run → Result → verify → VerificationResult → report",
        "CLI 编排准入、运行与 Result finalize；RuntimeExecutionService 负责节点调度、资源与 checkpoint"
      ]
    },
    {
      "dot": "emerald",
      "title": "框架核心与依赖边界",
      "items": [
        "核心模块目录：cli、application、packages、catalog、data_plane、runtime、research、simulation、results、evidence、platform、domain、operations、extensions",
        "research 是框架内的算法层，研究算法不直接读取研究数据库",
        "operations/framework_boundary.py 扫描核心源码；项目依赖锁由 extensions/governance.py 校验",
        "application/grid_data.py 是 Runtime 登记的数据适配器；研究计划存储位于 cli/research_plan_store.py",
        "platform 提供共享合同；图中保留主要依赖，不逐条展开共享 schema、日志和运维调用",
        "Workspace 服务位于 workspace.py；报告编排位于 cli/commands/evidence_lifecycle.py，输出由 cli/report_output.py 负责。"
      ]
    },
    {
      "dot": "violet",
      "title": "数据与独立复核",
      "items": [
        "Catalog 从使用者提供的显式 YAML 编译 Lock；公开仓库不附带本机数据声明或物理绑定。",
        "研究源库只读；providers 负责主取数，catalog/discovery 负责 schema 观测，data_plane/revision 与 factor_publication 负责来源与发布绑定",
        "ResultAssembler / ResultStore 封存结果，Verifier 只读封存输入并另存 VerificationResult",
        "金融 oracle 用内存 DuckDB 独立复算；模型与统计按各自验证合同复核，不回连研究库"
      ]
    },
    {
      "dot": "rose",
      "title": "适用范围",
      "items": [
        "图展示核心模块及可选 RD-Agent / ML 接入，不展开每个算子和项目 Worker",
        "中国市场声明、交易时段与资产规则属于可配置口径；能力状态以 capabilities.json 和当前 Catalog Lock 为准",
        "普通列式物化、分钟扫描和归档快照由各自数据入口接入同一 Typed DAG"
      ]
    },
    {
      "dot": "violet",
      "title": "RD-Agent 的位置与反馈边界",
      "items": [
        "RD-Agent 位于核心之外的研究提案层，通过 Workspace 进入正式研究主链。",
        "公式复现沿用人确认的定义；探索只接收独立验证通过的开发指标，test/holdout 不进入反馈。",
        "Qlib 位于计算层；运行完成、CLI 封存 Result 与独立验证分别判断成功状态。"
      ]
    }
  ]
}
