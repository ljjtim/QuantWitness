      "stage": 0,
      "row": 0
    },
    {
      "id": "catalog",
      "type": "security",
      "label": "Catalog / PIT 准入",
      "sublabel": "声明编译 + 漂移证明",
      "tag": "approved 槽位",
      "stage": 1,
      "row": 0
    },
    {
      "id": "plan",
