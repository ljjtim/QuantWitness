  "cards": [
    {
      "dot": "cyan",
      "title": "数据与计划分别进入取数节点",
      "items": [
        "源数据提供实际记录；Catalog 只读观察来源 schema 与修订，并给出绑定和 PIT 准入事实",
        "AdmittedQueryPlan 是取数依据，不承载原始数据；provider 从只读数据源读取并发布列式工件",
        "普通 DuckDB 源库以 read_only=True 打开，Parquet 输入按相应文件合同读取"
      ]
    },
    {
      "dot": "rose",
      "title": "时间可见性与漂移",
      "items": [
        "可见日期、已完成 bar 和来源修订政策由当前 Catalog Lock 约束",
        "取数前复查 schema，取数前后核对来源修订与指纹；变化阻止本次工件发布",
        "财报、成分、行业、复权与市场规则仍需使用当时可见的快照或有效区间"
      ]
    },
    {
      "dot": "violet",
      "title": "结果与验证分别封存",
      "items": [
        "ResultBundle 绑定正式表清单、输入修订、运行与配置身份及内容哈希",
        "Verifier 只读封存输入与结果，按独立金融、模型或统计合同生成 VerificationResult",
        "VerificationResult 另存文件并绑定 Result 身份；报告消费 Result 与验证文件",
        "图展示普通列式路径；分钟扫描与归档快照走相应入口，再接入相同结果和验证链"
      ]
    }
  ]
