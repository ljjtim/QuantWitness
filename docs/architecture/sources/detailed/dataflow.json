  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "数据与计划分别进入取数节点",
      "items": [
        "源数据提供实际记录；Catalog 只读观察来源并给出绑定、可见日期与 PIT 准入事实",
        "AdmittedQueryPlan 是取数依据，不承载原始数据；普通查询默认按需直接读取准入来源",
        "run、workspace run/execute 显式使用 --persist-inputs 才保存查询输入；该选择随调用冻结",
        "DuckDB 以 read_only=True 打开；来源描述与物理快照分开记录，归档仍须正式 Catalog/PIT 准入"
      ]
    },
    {
      "dot": "rose",
      "title": "时间可见性与漂移",
      "items": [
        "可见日期、completed bar 和来源修订政策由当前 Catalog Lock 约束",
        "直接输入与恢复检查原来源身份；来源变化后重新准入，不向旧检查点接入新数据",
        "财报、成分、行业、复权、公司行动与市场规则使用当时可见的快照或有效区间",
        "模型 holdout 在读取前登记 opened，失败消费不重置；最终评价不进入开发反馈"
      ]
    },
    {
      "dot": "violet",
      "title": "正式 Result 与直接消费",
      "items": [
        "ResultBundle 绑定正式表、指标、运行摘要、配置、实现与输入引用，正式 Result 原子发布后只读",
        "报告、比较、分析、导出和 Dashboard 直接消费 Result；分析生成独立 AnalysisResult",
        "Qlib 执行日频模型；LEAN 执行日线与一分钟策略，输出 orders、intents、daily、trace 及 metrics",
        "正式 Result、模型、计划和 holdout 账本持续保存；归档迁移同时保留实际输入依赖",
        "报告失败只重新报告，不重跑训练或交易；开发反馈只读取成功 Result 的开发指标"
      ]
    }
  ]
}
