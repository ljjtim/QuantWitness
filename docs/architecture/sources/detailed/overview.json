  "cards": [
    {
      "dot": "cyan",
      "title": "你：问题与研究约定",
      "items": [
        "人确认公式含义、窗口、可用时点、研究范围与预算。AI 草稿不能代替人的确认。",
        "实现位置：integrations/rdagent/src/quantwitness_rdagent/formula_spec.py"
      ]
    },
    {
      "dot": "violet",
      "title": "AI 研究助手 · RD-Agent",
      "items": [
        "可选集成，位于框架核心之外。公式复现固定定义；探索模式仅使用通过验证的开发指标，test/holdout 不进入反馈。",
        "实现位置：integrations/rdagent/src/quantwitness_rdagent/package_campaign.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "你的研究数据",
      "items": [
        "数据由使用者提供。归档快照与数据库是互斥来源；历史可见性必须有相应字段和来源说明。",
        "实现位置：src/research_pipeline/data_plane/providers/duckdb.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "研究入口 · Workspace",
      "items": [
        "人或 RD-Agent 均通过正式入口执行研究包。ResearchPackage 描述数据请求、算法步骤、参数和结果要求。",
        "实现位置：src/research_pipeline/cli/commands/workspace_flow.py"
      ]
    },
    {
      "dot": "rose",
      "title": "数据与时点检查",
      "items": [
        "Catalog 描述字段及来源；准入绑定来源和时点。取数时复查来源，按决策时点限制数据。PIT 不证明供应商没有修订历史。",
        "实现位置：src/research_pipeline/data_plane/admission.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "计算与原生回测",
      "items": [
        "Runtime 调度依赖图、资源与检查点。Qlib 是可选模型与表达式后端；原生仿真处理声明范围内的订单、费用、仓位和现金。",
        "实现位置：src/research_pipeline/runtime/execution_service.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "完整结果包 · Result",
      "items": [
        "Runtime 完成后由 CLI 调用 ResultAssembler 封存。保留正式输入、实现与结果引用；封存有独立成功状态。",
        "实现位置：src/research_pipeline/cli/commands/research_run.py"
      ]
    },
    {
      "dot": "rose",
      "title": "独立检查 · Verifier",
      "items": [
        "独立读取 Result 及其支持事实，产生 VerificationResult。项目公式验证器与金融 oracle 的检查范围需要显式声明。 开发探索只从验证通过的开发指标生成 AI 反馈，报告展示不是反馈的前置步骤。",
        "实现位置：src/research_pipeline/evidence/verification_result.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "报告与实验比较",
      "items": [
        "报告读取结果包和验证结果。开发探索反馈仅从验证通过的开发指标中提取，不把执行成功当作验证通过。",
        "实现位置：src/research_pipeline/cli/report_output.py"
      ]
    }
  ]
}
