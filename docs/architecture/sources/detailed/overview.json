  "cards": [
    {
      "dot": "cyan",
      "title": "你：问题与研究约定",
      "items": [
        "人确认公式含义、窗口、可用时点、研究范围与预算。AI 草稿不能代替人的确认。",
        "实现位置：integrations/rdagent/src/quantwitness_rdagent/formula_spec.py"
      ]
    },
    {
      "dot": "violet",
      "title": "AI 研究助手 · RD-Agent",
      "items": [
        "可选集成，位于框架核心之外。公式复现固定定义；探索模式仅使用成功 Result 的开发指标，test/holdout 不进入反馈。",
        "实现位置：integrations/rdagent/src/quantwitness_rdagent/package_campaign.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "你的研究数据",
      "items": [
        "数据由使用者提供。归档快照与数据库是互斥来源；历史可见性必须有相应字段和来源说明。",
        "实现位置：src/research_pipeline/data_plane/providers/duckdb.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "研究入口 · Workspace",
      "items": [
        "Workspace 共用正式主链，同次解析和编译后直接交接准入与执行。独立 package lint 是主动诊断入口。",
        "实现位置：src/research_pipeline/application/workspace_flow.py"
      ]
    },
    {
      "dot": "rose",
      "title": "数据与时点检查",
      "items": [
        "Catalog 描述字段及来源；准入绑定来源和时点。取数时复查来源，按决策时点限制数据。PIT 不证明供应商没有修订历史。",
        "实现位置：src/research_pipeline/data_plane/admission.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "模型计算与策略回测",
      "items": [
        "Runtime 调度依赖图、资源与检查点。Qlib 提供模型、处理器和表达式；日线与一分钟策略由 LEAN 执行，使用当时可见的数据及市场规则。",
        "实现位置：src/research_pipeline/runtime/execution_service.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "正式结果包 · Result",
      "items": [
        "应用服务在节点完成后调用 ResultAssembler，原子发布正式表、指标与实现引用。默认记录只读来源，--persist-inputs 才保存查询输入。",
        "实现位置：src/research_pipeline/application/research_run.py"
      ]
    },
    {
      "dot": "rose",
      "title": "直接读取 · ResultContext",
      "items": [
        "直接读取正式 Result，交付 snapshot、metrics、claim_level、limitations 和研究成本假设。成功 Result 的开发指标供 AI 反馈；报告不是反馈的前置步骤。",
        "实现位置：src/research_pipeline/results/delivery.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "报告与实验比较",
      "items": [
        "报告、比较、分析和导出直接消费 Result。模型报告使用 Qlib，组合和策略报告读取 LEAN 正式表；报告失败只重试报告。",
        "实现位置：src/research_pipeline/results/delivery.py"
      ]
    }
  ]
}
