  "cards": [
    {
      "dot": "cyan",
      "title": "按声明取数",
      "items": [
        "数据节点交接只读来源，算法节点按所需列和日期消费；原始来源与已保存的物理快照分别记录",
        "默认直接读取只读数据库或既有归档；--persist-inputs 才保存查询输入，选择随调用冻结",
        "主控复验节点产出并提交 checkpoint，再把正式引用传给就绪的下游节点",
        "RuntimeNodeContext 承载输入、工作路径与预算，由适配器读取"
      ]
    },
    {
      "dot": "emerald",
      "title": "应用服务发布 Result",
      "items": [
        "Runtime 负责节点执行与检查点，返回运行摘要和正式输出",
        "应用服务调用 ResultAssembler / ResultStore 原子发布正式 Result",
        "节点全部成功但 Result 未发布时，原 resume 只重试组装；已发布结果不重开",
        "当前结果保留来源、实现和配置引用；归档时携带实际依赖"
      ]
    },
    {
      "dot": "rose",
      "title": "直接交付与恢复",
      "items": [
        "load_result_context 读取正式 Result 的表、指标、声明限制和研究成本假设",
        "报告、比较、分析与导出直接消费 Result；报告失败不会重跑模型或交易",
        "AI 仅接收成功 Result 的开发指标；最终 test/holdout 不进入反馈"
      ]
    }
  ]
}
