{
  "schema_version": 4,
  "diagram_type": "lifecycle",
  "title": "运行状态",
  "question": "节点、运行和结果组装各自保留真实状态。",
  "output": "lifecycle-research-run",
  "nodes": [
    {
      "id": "plan",
      "label": "已准入计划",
      "detail": "固定输入、实现、参数与预算。"
    },
    {
      "id": "running",
      "label": "节点执行",
      "detail": "queued/running与心跳不代表输出成功。"
    },
    {
      "id": "checkpoint",
      "label": "成功 checkpoint",
      "detail": "内容、资源与交接合格后才能复用。"
    },
    {
      "id": "failure",
      "label": "中断或节点失败",
      "detail": "同身份resume或允许的retry；更改声明后重新准入。"
    },
    {
      "id": "finalize",
      "label": "Result组装",
      "detail": "全部节点成功但组装失败时只重试组装。"
    },
    {
      "id": "published",
      "label": "Result已发布",
      "detail": "结果只读，补齐completion与索引不重跑节点。"
    },
    {
      "id": "delivery",
      "label": "报告或导出",
      "detail": "结果消费失败后只重试交付，不重复训练或holdout。"
    }
  ],
  "edges": [
    {
      "source": "plan",
      "target": "running",
      "label": "启动"
    },
    {
      "source": "running",
      "target": "checkpoint",
      "label": "提交成功"
    },
    {
      "source": "running",
      "target": "failure",
      "label": "失败"
    },
    {
      "source": "failure",
      "target": "running",
      "label": "合法恢复"
    },
    {
      "source": "checkpoint",
      "target": "finalize",
      "label": "全部完成"
    },
    {
      "source": "finalize",
      "target": "published",
      "label": "原子发布"
    },
    {
      "source": "published",
      "target": "delivery",
      "label": "直接读取"
    }
  ]
}
